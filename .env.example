# 화면용 공개 값 (브라우저 번들에 들어감)
NEXT_PUBLIC_SUPABASE_URL=
# 화면용 공개 값 (브라우저 번들에 들어감)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 비밀. 32바이트 무작위 값을 표준 base64로(44자, = 하나로 끝남). 만들기 예:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 없거나 길이가 틀리면 할 일 적기·목록이 config 오류를 돌려준다.
TODO_ENCRYPTION_KEY=
# RLS 시험 계정
DUNO_TEST_A_EMAIL=
# RLS 시험 계정
DUNO_TEST_A_PASSWORD=
# RLS 시험 계정
DUNO_TEST_B_EMAIL=
# RLS 시험 계정
DUNO_TEST_B_PASSWORD=
# 알림(웹 푸시, PRD 7-8). 값은 PM이 서버 설정에 둔다. 이름만 여기 적는다. 없으면 알림은 켜지지 않고 앱은 그대로 돈다.
# 푸시 서명 공개 키(화면용 공개 값, 브라우저 번들에 들어감)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# 푸시 서명 비밀 키(서버 전용)
VAPID_PRIVATE_KEY=
# 푸시 서비스에 알리는 연락처(mailto: 또는 https:// 주소, 서버 전용)
VAPID_SUBJECT=
# 알림 예약 실행이 모든 사용자의 알림 설정·구독을 읽을 때만 쓰는 서버 키(서버 전용, 화면에 싣지 않는다)
SUPABASE_SERVICE_ROLE_KEY=
# 예약 실행 주소(/api/notify/tick)를 부르는 쪽이 보내는 비밀(서버 전용)
CRON_SECRET=
# 예약 실행 간격(분, 기본 15). 예약 도구의 간격과 같게 둔다.
NOTIFY_TICK_MINUTES=
