#!/bin/sh
# 비밀 검사 훅 — 커밋 직전에 staged diff에서 키 모양 문자열을 찾는다. 걸리면 커밋을 막는다.
#
# 설치 (클론·작업 폴더를 새로 만들 때마다, 저장소 맨 위에서 한 번):
#   git config --get core.hooksPath     ← 먼저 본다. 값이 있으면 덮지 말고 개발 에이전트에게 알린다
#   git config core.hooksPath .githooks
# 되돌리기:  git config --unset core.hooksPath
# 막히면 고치고 다시 커밋한다. --no-verify로 우회하지 않는다. 오탐이 확실한 줄만 그 줄에
#   secret-scan:allow 를 적는다(검사 출력에 「허용」으로 찍힌다).
# node가 없거나 검사가 실패(종료 코드 2·예상 못 한 오류)해도 커밋을 막는다 — 검사 없이 통과시키지 않는다.
# 머지 커밋은 .githooks/pre-merge-commit 이 이 파일을 부른다. fast-forward 머지는 커밋을 만들지 않아 어느 훅도 돌지 않는다.
#
# [AI 수정안] 22_개발 견본 pre-commit(SHA-256 900740073ce06affc1017d3e92458c12abb6b9c5c565f4730802f8c134cb483a,
# 702바이트)에서 바꾼 것 (2026-11-04, 22_개발 팀장 작업 지시):
#   - 검사 결과에 따라 한국어 안내 두 줄을 덧붙인다(걸림 / 검사 실패 / node 없음). 비개발자가 할 일을 알 수 있게
#   - 종료 코드 1이어도 「걸림」 줄이 없으면 검사 실패로 본다(스크립트가 깨져 node가 1로 끝난 경우)
#   - 첫 인자 merge 를 받으면(pre-merge-commit) 머지가 멈춘 상태라는 안내를 쓴다
#   - 막는 조건은 견본과 같다: 걸림, node 없음, 검사 실패
#   절차와 승인 시점의 출처: 22_개발 DEV_GUIDE.md 「비밀 검사」

dir=$(dirname "$0")
if [ "$1" = merge ]; then
  todo="할 일: 머지가 멈춘 상태예요. 개발 에이전트에게 알려 주세요(머지 취소는 git merge --abort)."
else
  todo="할 일: 그 값을 지우거나 .env로 옮긴 뒤 다시 커밋해 주세요. 잘못 걸린 것 같으면 개발 에이전트에게 알려 주세요."
fi

if ! command -v node >/dev/null 2>&1; then
  echo "비밀 검사: node가 없어 검사를 못 해서 커밋하지 않았어요." >&2
  echo "할 일: 개발 에이전트에게 알려 주세요." >&2
  exit 1
fi

out=$(node "$dir/secret-scan.mjs" --staged 2>&1)
code=$?
[ -n "$out" ] && printf '%s\n' "$out" >&2

if [ "$code" -eq 0 ]; then
  exit 0
fi
if [ "$code" -eq 1 ] && printf '%s\n' "$out" | grep -q '^  걸림 '; then
  echo "비밀 검사: 위 「걸림」 자리에 키처럼 보이는 값이 있어 커밋하지 않았어요." >&2
  echo "$todo" >&2
  exit 1
fi
echo "비밀 검사: 검사를 못 해서 커밋하지 않았어요(종료 코드 $code)." >&2
echo "할 일: 개발 에이전트에게 알려 주세요." >&2
exit 1
