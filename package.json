    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "supabase": "2.122.1",
    "vitest": "5.1.0",
    "vite": "8.3.5",
